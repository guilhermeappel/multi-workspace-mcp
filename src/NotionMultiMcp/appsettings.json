{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "PublicBaseUrl": "http://localhost:8080",
    "TokenGeneration": 1,
    "AuthDisabled": false,
    "ExtraRedirectUris": [],
