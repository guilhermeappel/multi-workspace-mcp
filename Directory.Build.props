<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A NuGet vulnerability advisory on a test package should raise a Dependabot PR, not break every build. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Style rules from .editorconfig with warning or error severity fail the build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The .NET SDK analyzers (no NuGet package) at the Recommended set; the exceptions are in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>
</Project>
